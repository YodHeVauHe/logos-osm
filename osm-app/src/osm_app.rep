// RemoteObjects source definition for the OSM distribution app.
class OsmApp
{
    // All 72 predefined regions as a JSON array (frozen set).
    PROP(QString regions READWRITE)

    // Registry entries JSON (hosted status, versions, cids).
    PROP(QString registryEntries READWRITE)

    // Updates available as a JSON array of RegionUpdate.
    PROP(QString updates READWRITE)

    // idle | hosting | downloading | importing | error
    PROP(QString phase READWRITE)

    // Last human-readable status line.
    PROP(QString status READWRITE)

    // true while a job is in flight
    PROP(bool working READWRITE)

    // Last download/import verification result ("verified"/"MISMATCH"/"")
    PROP(QString lastVerification READWRITE)

    SLOT(void hostRegions(QString regionsCsv))
    SLOT(void importRegion(QString region, QString filePath, QString md5Override))
    SLOT(void downloadRegion(QString region, QString destDir))
    SLOT(void refresh())
    SLOT(void checkUpdates())
};
